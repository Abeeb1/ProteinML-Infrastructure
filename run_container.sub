#!/bin/bash
#SBATCH --job-name=proteinml-test
#SBATCH --partition=requeue
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=2G
#SBATCH --time=00:10:00
#SBATCH --output=proteinml-%j.out

set -euo pipefail

cd "${SLURM_SUBMIT_DIR}"

echo "=== HPC Container Job ==="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Compute node: $(hostname)"
echo "Allocated CPUs: ${SLURM_CPUS_PER_TASK}"
echo "Start: $(date)"

/usr/bin/time -v \
    apptainer exec --cleanenv \
    --bind "$PWD:$PWD" \
    proteinml.sif \
    python validate.py

echo "End: $(date)"
echo "=== Job completed successfully ==="
